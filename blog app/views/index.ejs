
<%- include("partials/headers") %>

<% if(posts.length == 0){ %>
    <h2>no posts yet</h2>
<% } else{%>
    <% posts.forEach((post)=>{ %>
        <div class="posts">
            <h2><%=post.title %></h2>
            <p><%= post.content %></p>
            <a href="/edit/<%= post.id %>">Edit</a>
            <a href="/delete/<%=post.id %>">Delete</a>
        </div>
  <%   }) %>
<% } %>




<%- include("partials/footer") %>